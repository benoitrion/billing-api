{
  "name": "billing-api with Copal",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22",
  "postCreateCommand": "npm install --no-audit --no-fund",
  "postAttachCommand": "bash .devcontainer/get-copal.sh && code --install-extension /tmp/copal-vscode.vsix --force || true",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "src/invoice/vat.ts",
        "README.md"
      ]
    },
    "vscode": {
      "extensions": [
        "GitHub.copilot-chat"
      ]
    }
  }
}
