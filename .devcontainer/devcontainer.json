{
  "name": "billing-api with Copal",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22",
  "postCreateCommand": "npm install --no-audit --no-fund && bash .devcontainer/get-copal.sh",
  "postAttachCommand": "code --install-extension /tmp/copal-vscode.vsix --force || true",
  "customizations": {
    "codespaces": { "openFiles": ["src/invoice/vat.ts", "README.md"] }
  }
}
