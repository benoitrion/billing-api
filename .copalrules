# Copal team rules for billing-api. Questions first: nothing blocks unless a rule says enforce.
version: 4
project: billing-api
mode: coach
risk: ["src/invoice/**", "src/ledger/**", "src/ports/**", "src/payments/**"]
extends:
  - builtin:security
  - builtin:quality
  - builtin:testing

redact:
  - name: customer-iban
    pattern: "BE\\d{14}"

rules:
  - id: ui-no-persistence
    category: architecture
    deny: "src/web/** -> src/persistence/**"
    why: "Controllers call services, services call ports: persistence stays behind the API boundary."
    coach:
      question: "Which service should own this query, so the controller doesn't need to know the database?"
      reference: https://alistair.cockburn.us/hexagonal-architecture/

  - id: ledger-rounding
    category: architecture
    paths: ["src/**/*.ts"]
    exclude: ["src/ports/**"]
    pattern: "Math\\.round\\(\\s*([^()]+?)\\s*\\*\\s*100\\s*\\)\\s*/\\s*100"
    fix:
      with: "LedgerPort.round($1, Currency.EUR)"
    message: "Inline rounding bypasses LedgerPort"
    why: "Rounding in one place keeps invoices and the ledger reconciled."
    coach:
      question: "Who owns rounding in this codebase?"
      kata: https://github.com/emilybache/SupermarketReceipt-Refactoring-Kata

  - id: approved-dependencies
    category: dependency
    dependencies:
      allow: ["@billing/*", "zod", "pino", "fastify", "decimal.js", "typescript", "@types/*", "vitest", "tsx"]
      deny: [moment, left-pad, request]
    why: "New packages need a security and licence review."
    coach:
      question: "Which package we already use could do this?"

  - id: tests-with-code
    category: testing
    paths: ["src/**/*.ts"]
    exclude: ["src/**/*.test.ts", "src/server.ts"]
    requireTest:
      test: "src/**/{name}.test.ts"
    why: "Billing rules are only as safe as the examples that pin them down."
    coach:
      question: "Which example proves this change is right — is it a test yet?"

# Pass/fail on what a change introduces (shown on every pull request).
gate:
  maxNew: { high: 0 }
  requireTests: true
